# AlgoBets AI - Social Media Bot Configuration
# Copy this file to .env and fill in your credentials

# ═══════════════════════════════════════════════════════════════════════════════
# API CONFIGURATION
# ═══════════════════════════════════════════════════════════════════════════════

API_BASE_URL=https://algobetsai.onrender.com
BACKEND_API_KEY=your_backend_api_key_here

# ═══════════════════════════════════════════════════════════════════════════════
# TWITTER API V2 CREDENTIALS
# Get these from: https://developer.twitter.com/en/portal/dashboard
# ═══════════════════════════════════════════════════════════════════════════════

TWITTER_BEARER_TOKEN=your_twitter_bearer_token_here

# ═══════════════════════════════════════════════════════════════════════════════
# DISCORD BOT CREDENTIALS
# Get these from: https://discord.com/developers/applications
# ═══════════════════════════════════════════════════════════════════════════════

DISCORD_BOT_TOKEN=your_discord_bot_token_here
DISCORD_PUBLIC_CHANNEL_ID=your_public_channel_id
DISCORD_PREMIUM_CHANNEL_ID=your_premium_channel_id
DISCORD_VIP_CHANNEL_ID=your_vip_channel_id

# ═══════════════════════════════════════════════════════════════════════════════
# POSTING CONFIGURATION (OPTIONAL)
# ═══════════════════════════════════════════════════════════════════════════════

# How many top picks to post
POST_TOP_N_PICKS=3

# Minimum edge percentage to post (e.g., 2.0 = 2%)
MIN_EDGE_FOR_POSTING=2.0

# Minimum confidence percentage to post (e.g., 65.0 = 65%)
MIN_CONFIDENCE_FOR_POSTING=65.0

# Timezone for scheduling
APP_TIMEZONE=America/New_York

