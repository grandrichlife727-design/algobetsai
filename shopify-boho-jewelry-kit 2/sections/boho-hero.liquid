<section class="boho-card" style="padding: 28px; margin: 18px 0;">
  <p class="boho-chip" style="display:inline-block;">Boho Luxe Everyday</p>
  <h1 style="font-family: Georgia, serif; font-size: clamp(34px, 6vw, 60px); margin: 12px 0 8px; line-height:1.05;">
    Layered, golden, and made to be noticed.
  </h1>
  <p style="max-width: 640px; color: var(--boho-muted); font-size: 17px;">
    Shop statement-ready stacks, charm pieces, and giftable boho jewelry with fast shipping.
  </p>
  <div style="margin-top: 16px; display:flex; gap:10px; flex-wrap:wrap;">
    <a href="/collections/all" class="boho-btn">Shop New Arrivals</a>
    <a href="/collections/bestsellers" class="boho-chip" style="text-decoration:none;">Bestsellers</a>
  </div>
</section>

{% schema %}
{
  "name": "Boho Hero",
  "settings": [],
  "presets": [{"name": "Boho Hero"}]
}
{% endschema %}
